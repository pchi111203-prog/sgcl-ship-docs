{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "includeFiles": "{frontend/dist/**,backend/**}",
      "excludeFiles": "{frontend/node_modules/**,backend/data/**,backend/tests/**}"
    }
  }
}
